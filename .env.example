# ==============================================================================
# OpenGEO CLI Environment Configuration Example
# Copy this file to .env and configure your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Credentials (Configure at least one to enable live probing)
# ------------------------------------------------------------------------------

# Option A: OpenRouter (Recommended - Single API Key for 100+ Models)
# Access Claude, Gemini, DeepSeek, Llama, and GPT models via one account.
# Default model: google/gemini-2.5-flash (fast & cost-efficient)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option B: Google Gemini (Direct Connection)
# Default model: gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Option C: DeepSeek (Direct Connection)
# Default model: deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Option D: OpenAI (Direct Connection)
# Default model: gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 2. Custom Model & Gateway Overrides (Optional)
# ------------------------------------------------------------------------------
# Override default model name (e.g. google/gemini-2.5-flash, gemini-2.5-flash, deepseek-chat, gpt-4o-mini)
# LLM_MODEL=google/gemini-2.5-flash

# Custom OpenAI-compatible proxy or local server (e.g. Ollama, vLLM, OneAPI)
# LLM_BASE_URL=http://localhost:11434/v1
